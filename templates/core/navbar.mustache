{{!
    @template core/navbar

    Snap theme override of core/navbar, built by theme_snap\output\core_renderer::navbar(): My Courses first, then
    the course by its short name with a home icon, then the rest. Home, Dashboard and categories above a course are
    left out. On an activity's pages, an Exit activity link follows, back to the course page at the activity.

    Context variables required for this template:
    * crumbs - array of items
      * url - string, empty for an item without a link
      * text - string (HTML)
      * title - string, optional tooltip
      * class - string, extra classes
      * courseicon - boolean, the course's home icon
      * hidden - boolean
      * last - boolean, the current page
    * exiturl - string, optional
    * onlycourse - boolean, the crumbs are only My Courses and the course

    Example context (json):
    {
        "crumbs": [
            {"url": "#", "text": "My Courses", "class": "snap-crumb-mycourses"},
            {"url": "#", "text": "XLSQ3202110: 61065 / 61066", "title": "Provide quality service", "class": "snap-crumb-course", "courseicon": true},
            {"url": "#", "text": "Week 1"},
            {"url": "#", "text": "Important message", "last": true}
        ],
        "exiturl": "#"
    }
}}
{{#crumbs.0}}
<nav aria-label="{{#str}}breadcrumb, access{{/str}}"{{#onlycourse}} class="snap-crumbs-courseonly"{{/onlycourse}}>
    <ol class="breadcrumb">{{!
        }}{{#crumbs}}
            <li class="breadcrumb-item {{class}}{{#hidden}} dimmed_text{{/hidden}}">{{!
                }}{{#url}}<a href="{{url}}"{{#last}} aria-current="page"{{/last}}{{#title}} title="{{title}}"{{/title}}>{{!
                    }}{{#courseicon}}{{#pix}} i/home, core {{/pix}}{{/courseicon}}{{{text}}}</a>{{/url}}{{!
                }}{{^url}}<span{{#last}} aria-current="page"{{/last}}>{{{text}}}</span>{{/url}}{{!
            }}</li>
        {{/crumbs}}{{!
    }}</ol>
</nav>
{{/crumbs.0}}
{{#exiturl}}
<a class="snap-exit-activity" href="{{exiturl}}"><i class="icon fa fa-circle-xmark" aria-hidden="true"></i>{{#str}}exitactivity, theme_snap{{/str}}</a>
{{/exiturl}}
