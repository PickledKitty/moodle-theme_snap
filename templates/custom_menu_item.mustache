{{!
    @template theme_snap/custom_menu_item

    One item of the custom menu: a link, or a dropdown of links. Snap adds an icon before an item's text
    (icon.class: Font Awesome classes; icon.maskurl: one of Snap's pix/menu icons, drawn in the text colour), and
    section headings in dropdowns: each section's items are a group labelled by its heading.
    See core_renderer::snap_custom_menu_context().

    Example context (json):
    {
        "uniqid": "1",
        "text": "Library",
        "icon": {"class": "fa-solid fa-building-columns"},
        "haschildren": true,
        "sections": [
            {
                "heading": {"id": "snap-menu-heading-1", "text": "Referencing"},
                "items": [
                    {"text": "A guide", "url": "https://example.com", "icon": {"class": "fa-solid fa-arrow-right"} }
                ]
            }
        ]
    }
}}
{{^divider}}
{{#haschildren}}
<li role="none" class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" id="drop-down-{{uniqid}}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" href="#" aria-controls="drop-down-menu-{{uniqid}}" role="menuitem">
        {{#icon}}{{#class}}<i class="snap-menu-icon {{class}}" aria-hidden="true"></i>{{/class}}{{#maskurl}}<span class="snap-menu-icon snap-menu-icon-mask" style="-webkit-mask-image: url('{{maskurl}}'); mask-image: url('{{maskurl}}');" aria-hidden="true"></span>{{/maskurl}}{{/icon}}<span class="snap-custom-menu-text">{{{text}}}</span>
    </a>
    <div class="dropdown-menu" role="menu" id="drop-down-menu-{{uniqid}}" aria-labelledby="drop-down-{{uniqid}}">
        {{#sections}}
            {{#heading}}
            <div role="group" aria-labelledby="{{id}}">
                <div class="dropdown-header snap-custom-menu-heading" id="{{id}}" role="presentation">{{#icon}}{{#class}}<i class="snap-menu-icon {{class}}" aria-hidden="true"></i>{{/class}}{{#maskurl}}<span class="snap-menu-icon snap-menu-icon-mask" style="-webkit-mask-image: url('{{maskurl}}'); mask-image: url('{{maskurl}}');" aria-hidden="true"></span>{{/maskurl}}{{/icon}}<span>{{{text}}}</span></div>
            {{/heading}}
            {{#items}}
                {{^divider}}
                <a class="dropdown-item" role="menuitem" href="{{{url}}}" {{#title}}title="{{{title}}}"{{/title}}>{{#icon}}{{#class}}<i class="snap-menu-icon {{class}}" aria-hidden="true"></i>{{/class}}{{#maskurl}}<span class="snap-menu-icon snap-menu-icon-mask" style="-webkit-mask-image: url('{{maskurl}}'); mask-image: url('{{maskurl}}');" aria-hidden="true"></span>{{/maskurl}}{{/icon}}{{{text}}}</a>
                {{/divider}}
                {{#divider}}
                <div class="dropdown-divider" role="separator"></div>
                {{/divider}}
            {{/items}}
            {{#heading}}
            </div>
            {{/heading}}
        {{/sections}}
    </div>
</li>
{{/haschildren}}
{{^haschildren}}
<li role="none" class="nav-item">
    <a class="nav-link" role="menuitem" href="{{{url}}}" {{#title}}title="{{{title}}}"{{/title}}>{{#icon}}{{#class}}<i class="snap-menu-icon {{class}}" aria-hidden="true"></i>{{/class}}{{#maskurl}}<span class="snap-menu-icon snap-menu-icon-mask" style="-webkit-mask-image: url('{{maskurl}}'); mask-image: url('{{maskurl}}');" aria-hidden="true"></span>{{/maskurl}}{{/icon}}<span class="snap-custom-menu-text">{{{text}}}</span></a>
</li>
{{/haschildren}}
{{/divider}}
