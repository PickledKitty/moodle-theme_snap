{{!
    @template theme_boost/carousel

    The front page's cover carousel. Each slide's image, and its optional image for small screens ("imagesmall"),
    are custom properties the styles use (_core.scss). With "banner" (the Banner slide style), each slide has its
    image's shape ("ratio" and "ratiosmall", width / height, and "height" in pixels) and its caption is only for
    screen readers.

    Example context (json):
    {
        "banner": false,
        "slides": [
         {
             "index": 0,
             "active": "active",
             "name": "slide_one",
             "image": "",
             "title": "Slide title",
             "subtitle": "Slide subtitle",
             "imagesmall": "",
             "ratio": "",
             "ratiosmall": "",
             "height": 0,
             "slidelabel": "Slide 1 of 2"
         },
         {
             "index": 1,
             "active": "",
             "name": "slide_two",
             "image": "",
             "title": "Slide title",
             "subtitle": "Slide subtitle",
             "imagesmall": "",
             "ratio": "",
             "ratiosmall": "",
             "height": 0,
             "slidelabel": "Slide 2 of 2"
         }
        ]
    }
}}

<section id="snap-site-carousel" class="carousel slide{{#banner}} snap-carousel-banner{{/banner}}" aria-label="{{covercarousellabel}}">
    <span class="visually-hidden">{{carouselsronlytext}}</span>

    {{#slides}}
        <link rel="preload" as="image" href="{{{image}}}"{{#imagesmall}} media="(min-width: 768px)"{{/imagesmall}}>
        {{#imagesmall}}
            <link rel="preload" as="image" href="{{{imagesmall}}}" media="(max-width: 767.98px)">
        {{/imagesmall}}
    {{/slides}}

    <div class="carousel-inner" id="snap-carousel-container">
        <!-- Carousel slides. -->
        {{#slides}}
            <div class="carousel-item carousel-{{name}} {{active}}" role="group" aria-label="{{slidelabel}}">
                <div class="carousel-slide" style="--snap-slide-image: url({{{image}}});{{#imagesmall}} --snap-slide-image-small: url({{{imagesmall}}});{{/imagesmall}}{{#ratio}} --snap-slide-ratio: {{ratio}}; --snap-slide-height: {{height}}px;{{/ratio}}{{#ratiosmall}} --snap-slide-ratio-small: {{ratiosmall}};{{/ratiosmall}}">
                    <div class="carousel-caption{{#banner}} visually-hidden{{/banner}}">
                        <h1>{{title}}</h1>
                        <p>{{subtitle}}</p>
                    </div>
                </div>
            </div>
        {{/slides}}
    </div>

    <div class="carousel-controls-capsule {{carouselhidecontrols}}">
        <div id="carousel-play-resume-buttons">
            <span class="carousel-controls-divider" aria-hidden="true"></span>
            <button id="carousel-toggle-button" role="button" class="btn btn-default btn-xs"
                    aria-pressed="false"
                    data-label-play="{{carouselplaybutton}}"
                    data-label-pause="{{carouselpausebutton}}"
                    aria-label="{{carouselpausebutton}}">
                <span class="icon fa fa-pause fa-fw"></span>
            </button>
        </div>

        <a class="carousel-control-prev" href="#snap-site-carousel" role="button" data-bs-slide="prev">
            <i class="carousel-control-prev-icon fa-solid fa-caret-left" aria-hidden="true"></i>
            <span class="visually-hidden">Previous slide</span>
        </a>

        <ul role="list" class="carousel-indicators js-only">
            {{#slides}}
                <li>
                    <button data-bs-target="#snap-site-carousel" data-bs-slide-to="{{index}}" class="{{active}}" aria-label="{{dotlabel}}"></button>
                </li>
            {{/slides}}
        </ul>

        <a class="carousel-control-next" href="#snap-site-carousel" role="button" data-bs-slide="next">
            <i class="carousel-control-next-icon fa-solid fa-caret-right" aria-hidden="true"></i>
            <span class="visually-hidden">Next slide</span>
        </a>
    </div>
</section>
